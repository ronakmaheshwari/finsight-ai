      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^26.4.1",
    "eslint": "^9.39.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.4.1"
  }
}
