{
  "name": "@repo/shared",
  "version": "1.0.0",
  "description": "Enums, rule catalog, Zod schemas and API types shared by the API and the web app",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "keywords": [],
