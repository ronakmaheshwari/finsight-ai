{
  "name": "@repo/db",
  "version": "1.1.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma skills sync || exit 0",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:push": "prisma db push --config prisma7.config.ts",
    "db:reset": "prisma migrate reset --force --config prisma7.config.ts && npm run db:seed --workspace=api",
    "check-types": "tsc --noEmit",
    "build": "tsc -b",
    "lint": "eslint . --max-warnings 0"
  },
  "keywords": [],
  "author": "Ronak",
  "license": "ISC",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@repo/utils": "*",
    "@types/dotenv": "^6.1.1",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^26.4.1",
    "dotenv": "^16.0.3",
    "eslint": "^9.39.5",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
