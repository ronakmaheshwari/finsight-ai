generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

enum DatasetStatus {
  UPLOADED
  VALIDATING
  VALIDATED
  FAILED
}

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseStatus {
  OPEN
  IN_REVIEW
  ESCALATED
  DISMISSED
  CONFIRMED
  CLOSED
}

enum EntityType {
  EMPLOYEE
  VENDOR
  BANK_ACCOUNT
  TRANSACTION
  INVOICE
  PO
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DELETED
  DORMANT
  UNVERIFIED
}

enum RuleCategory {
  ANOMALY
  RELATIONSHIP
  CONTROL
}

enum AiJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum AiReviewStatus {
  PENDING
  ACCEPTED
  EDITED
  REJECTED
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  users       User[]
  engagements Engagement[]
  ruleConfigs RuleConfig[]
  auditLogs   AuditLog[]
}

model User {
  id                     String     @id @default(cuid())
  orgId                  String
  name                   String
  email                  String     @unique
  password               String
  role                   Role
  userStatus             UserStatus @default(UNVERIFIED)
  forgetPasswordToken    String?    @unique
  forgetPasswordOtpExpire DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  org                    Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jwtToken               JWTToken[]
  ownedEngagements       Engagement[]      @relation("EngagementOwner")
  memberships            EngagementMember[]
  datasets               Dataset[]         @relation("DatasetUploader")
  triggeredRuns          AnalysisRun[]     @relation("RunTrigger")
  assignedCases          Case[]            @relation("CaseAssignee")
  decidedCases           Case[]            @relation("CaseDecider")
  authoredCaseNotes      CaseNote[]        @relation("CaseNoteAuthor")
  aiRequests             AiInvestigation[] @relation("AiRequester")
  aiReviews              AiInvestigation[] @relation("AiReviewer")
  updatedRules           RuleConfig[]      @relation("RuleUpdater")
  auditLogs              AuditLog[]

  @@index([orgId])
}

model JWTToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Engagement {
  id          String   @id @default(cuid())
  orgId       String
  ownerId     String
  clientName  String
  title       String
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User               @relation("EngagementOwner", fields: [ownerId], references: [id])
  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  datasets    Dataset[]
  members     EngagementMember[]
  cases       Case[]

  @@index([ownerId])
  @@index([orgId])
}

model EngagementMember {
  engagementId String
  userId       String
  createdAt    DateTime @default(now())

  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([engagementId, userId])
  @@index([userId])
}

model Dataset {
  id               String        @id @default(cuid())
  engagementId     String
  uploadedById     String
  name             String
  status           DatasetStatus @default(UPLOADED)
  rowCounts        Json?
  validationErrors Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  engagement     Engagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  uploadedBy     User          @relation("DatasetUploader", fields: [uploadedById], references: [id])
  employees      Employee[]
  vendors        Vendor[]
  bankAccounts   BankAccount[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  transactions   Transaction[]
  analysisRun    AnalysisRun[]

  @@index([engagementId])
  @@index([uploadedById])
}

model BankAccount {
  id                String @id @default(cuid())
  datasetId         String
  externalId        String
  accountNumberHash String
  bankName          String

  dataset   Dataset    @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  employees Employee[]
  vendors   Vendor[]

  @@unique([datasetId, externalId])
  @@index([datasetId])
  @@index([datasetId, accountNumberHash])
}

model Employee {
  id            String   @id @default(cuid())
  datasetId     String
  externalId    String
  name          String
  department    String
  address       String?
  phone         String?
  email         String?
  approvalLimit Decimal?
  bankAccountId String?

  dataset           Dataset         @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  bankAccount       BankAccount?    @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  transactions      Transaction[]
  createdVendors    Vendor[]        @relation("VendorCreator")
  approvedPOs       PurchaseOrder[] @relation("PoApprover")
  approvedInvoices  Invoice[]       @relation("InvoiceApprover")

  @@unique([datasetId, externalId])
  @@index([datasetId])
  @@index([bankAccountId])
}

model Vendor {
  id            String   @id @default(cuid())
  datasetId     String
  externalId    String
  name          String
  taxId         String?
  address       String?
  phone         String?
  email         String?
  createdAt     DateTime @default(now())
  status        String?
  bankAccountId String?
  createdById   String?

  dataset        Dataset         @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  bankAccount    BankAccount?    @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  createdBy      Employee?       @relation("VendorCreator", fields: [createdById], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]
  invoice        Invoice[]
  transactions   Transaction[]

  @@unique([datasetId, externalId])
  @@index([datasetId])
  @@index([createdById])
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  datasetId    String
  externalId   String
  vendorId     String
  amount       Decimal
  issuedDate   DateTime
  approvedById String?

  dataset    Dataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  vendor     Vendor    @relation(fields: [vendorId], references: [id])
  approvedBy Employee? @relation("PoApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  invoices   Invoice[]

  @@unique([datasetId, externalId])
  @@index([datasetId])
  @@index([vendorId])
  @@index([approvedById])
}

model Invoice {
  id            String   @id @default(cuid())
  datasetId     String
  externalId    String
  vendorId      String
  poId          String?
  invoiceNumber String
  amount        Decimal
  invoiceDate   DateTime
  approvedById  String?

  dataset       Dataset        @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  approvedBy    Employee?      @relation("InvoiceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  transactions  Transaction[]

  @@unique([datasetId, externalId])
  @@index([datasetId, vendorId])
  @@index([datasetId, invoiceDate])
  @@index([poId])
  @@index([approvedById])
}

model Transaction {
  id          String   @id @default(cuid())
  datasetId   String
  externalId  String
  invoiceId   String
  vendorId    String?
  employeeId  String?
  amount      Decimal
  postedAt    DateTime
  description String?

  dataset  Dataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  invoice  Invoice   @relation(fields: [invoiceId], references: [id])
  vendor   Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([datasetId, externalId])
  @@index([datasetId, postedAt])
  @@index([invoiceId])
  @@index([vendorId])
  @@index([employeeId])
}

model AnalysisRun {
  id            String    @id @default(cuid())
  datasetId     String
  triggeredById String
  status        RunStatus @default(QUEUED)
  jobId         String?
  ruleSnapshot  Json
  summary       Json?
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  dataset     Dataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  triggeredBy User         @relation("RunTrigger", fields: [triggeredById], references: [id])
  signals     RiskSignal[]
  cases       Case[]

  @@index([datasetId, createdAt])
}

model RiskSignal {
  id             String       @id @default(cuid())
  runId          String
  caseId         String?
  ruleKey        String
  category       RuleCategory
  severity       Severity
  weight         Int
  title          String
  entityType     EntityType
  entityId       String
  vendorId       String?
  entities       Json
  invoiceIds     String[]
  exposureAmount Decimal?
  evidence       Json
  createdAt      DateTime     @default(now())

  run  AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  case Case?       @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([caseId])
  @@index([runId, ruleKey])
  @@index([runId, vendorId])
}

model Case {
  id                 String     @id @default(cuid())
  engagementId       String
  runId              String
  code               String
  title              String
  primaryEntityType  EntityType
  primaryEntityId    String
  primaryEntityLabel String
  entities           Json
  riskScore          Int
  severity           Severity
  exposureAmount     Decimal
  priority           Float
  signalCount        Int
  status             CaseStatus @default(OPEN)
  assignedToId       String?
  decisionReason     String?
  decidedById        String?
  decidedAt          DateTime?
  scoreBreakdown     Json
  graph              Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  engagement Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  run        AnalysisRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  assignedTo User?           @relation("CaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  decidedBy  User?           @relation("CaseDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  signals    RiskSignal[]
  notes      CaseNote[]
  ai         AiInvestigation?

  @@unique([runId, code])
  @@index([engagementId, status])
  @@index([runId, priority])
  @@index([assignedToId])
}

model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  case   Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User @relation("CaseNoteAuthor", fields: [authorId], references: [id])

  @@index([caseId, createdAt])
}

model AiInvestigation {
  id             String         @id @default(cuid())
  caseId         String         @unique
  requestedById  String
  status         AiJobStatus    @default(QUEUED)
  error          String?
  model          String?
  promptVersion  String?
  packetHash     String?
  output         Json?
  editedOutput   Json?
  inputTokens    Int?
  outputTokens   Int?
  reviewStatus   AiReviewStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  case        Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("AiRequester", fields: [requestedById], references: [id])
  reviewedBy  User? @relation("AiReviewer", fields: [reviewedById], references: [id])
}

model RuleConfig {
  id          String   @id @default(cuid())
  orgId       String
  ruleKey     String
  enabled     Boolean  @default(true)
  weight      Int
  params      Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  updatedBy User?        @relation("RuleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([orgId, ruleKey])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}
