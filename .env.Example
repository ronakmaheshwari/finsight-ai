# ---------------------------------------------------------------------------
# FinSight AI - example environment. Copy the values you need into `.env`.
# Never commit real secrets. The API validates the required keys at boot.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=3000

# Postgres (Prisma) and Redis (BullMQ / cache)
DATABASE_URL="postgresql://finsight:finsight@localhost:5432/finsight"
REDIS_URL="redis://localhost:6379"

RUN_MIGRATION_RESET=false
RUN_MIGRATION=false

# Auth. ACCESS_TTL uses the jsonwebtoken duration format ("15m", "1h").
JWT_SECRET="change-me-to-at-least-32-characters"
JWT_REFRESH_SECRET="change-me-to-a-different-32-character-secret"
ACCESS_TTL="15m"
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
SALTROUND=12

# Bank-account hashing (HMAC-SHA256). Rotating it changes every stored hash.
ACCOUNT_HASH_SECRET="change-me-account-hash-secret"

# Existing legacy keys kept for the current code paths
ENCRYPTION_SECRET="change-me-encryption-secret"
JWT_EXPIRE="1d"

# Uploads
UPLOAD_MAX_MB=25

# AI investigation.
# Provider order when AI_PROVIDER is empty: Claude -> Ollama -> OpenCode -> mock.
# Set AI_PROVIDER to anthropic | ollama | opencode | mock to pin one.
# MOCK_LLM=true (or no key at all) uses deterministic offline output.
AI_PROVIDER=""

# 1) Anthropic Claude
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-sonnet-4-5"

# 2) Ollama — Cloud (https://ollama.com/settings/keys) or a local daemon
OLLAMA_API_KEY=""
OLLAMA_HOST="https://ollama.com"          # local daemon: http://localhost:11434
OLLAMA_MODEL="gpt-oss:120b"

# 3) OpenCode Console (Zen), OpenAI-compatible
OPENCODE_API_KEY=""
OPENCODE_BASE_URL="https://opencode.ai/inference/openai/v1"
OPENCODE_MODEL="deepseek-v4.1-flash"

LLM_MAX_OUTPUT_TOKENS=2000
MOCK_LLM=false

# CORS / web app
WEB_ORIGIN="http://localhost:5173"
VITE_API_URL="http://localhost:3000/api/v1"
VITE_FRONTEND_URL="http://localhost:5173"
VITE_SHOW_DEMO_LOGINS=true
API_BASE_URL="http://localhost:3000"

# Seeder (development only)
SEED_PASSWORD="Demo@1234"
