{
  "name": "Finsight-AI",
  "private": true,
  "scripts": {
    "postinstall": "npm run db:generate",
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev worker:dev",
    "lint": "turbo run lint --concurrency=2",
    "lint:fix": "turbo run lint --concurrency=2 -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "npm run db:generate --workspace=@repo/db",
    "db:migrate": "npm run db:migrate --workspace=@repo/db",
    "db:seed": "npm run db:seed --workspace=api",
    "db:reset": "npm run db:reset --workspace=@repo/db",
    "seed:export-demo-workbook": "npm run seed:export-demo-workbook --workspace=api",
    "worker": "npm run worker --workspace=api"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "6.0.3"
  },
  "//typescript": "Pinned to 6.0.3 because typescript-eslint's peer range is <6.1.0 and it loads the hoisted copy. Individual workspaces still use TypeScript 7 for tsc.",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.19.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "bcrypt@6.0.0": true
  }
}
