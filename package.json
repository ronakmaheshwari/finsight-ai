{
  "name": "Finsight-AI",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint --concurrency=2",
    "lint:fix": "turbo run lint --concurrency=2 -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "6.0.3"
  },
  "//typescript": "Pinned to 6.0.3 because typescript-eslint's peer range is <6.1.0 and it loads the hoisted copy. Individual workspaces still use TypeScript 7 for tsc.",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "bcrypt@6.0.0": true
  }
}
