{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "packages/eslint-config/**",
    "**/eslint.config.*"
  ],
  "globalEnv": [
    "ACCESS_TTL",
    "ACCOUNT_HASH_SECRET",
    "AI_MODEL",
    "AI_PROVIDER",
    "ANTHROPIC_API_KEY",
    "API_BASE_URL",
    "COOKIE_SECURE",
    "DATABASE_URL",
    "ENCRYPTION_SECRET",
    "JWT_EXPIRE",
    "JWT_REFRESH_SECRET",
    "JWT_SECRET",
    "LLM_MAX_OUTPUT_TOKENS",
    "LLM_MODEL",
    "MOCK_LLM",
    "NODE_ENV",
    "OLLAMA_API_KEY",
    "OLLAMA_HOST",
    "OLLAMA_MODEL",
    "OPENCODE_API_KEY",
    "OPENCODE_BASE_URL",
    "OPENCODE_MODEL",
    "PORT",
    "REDIS_URL",
    "REFRESH_TTL_DAYS",
    "SALTROUND",
    "SEED_PASSWORD",
    "UPLOAD_MAX_MB",
    "VITE_API_URL",
    "VITE_FRONTEND_URL",
    "VITE_SHOW_DEMO_LOGINS",
    "WEB_ORIGIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types",
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "worker:dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
