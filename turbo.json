{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["packages/eslint-config/**", "**/eslint.config.*"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "ENCRYPTION_SECRET",
    "JWT_EXPIRE",
    "JWT_SECRET",
    "SALTROUND",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
